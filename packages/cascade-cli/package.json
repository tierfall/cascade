{
  "name": "@tierfall/cascade-cli",
  "version": "0.0.0",
  "description": "Headless workflow trigger CLI for Cascade. Single command in v0.1: `cascade run <workflow-id>`.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/tierfall/cascade.git",
    "directory": "packages/cascade-cli"
  },
  "homepage": "https://github.com/tierfall/cascade",
  "bugs": {
    "url": "https://github.com/tierfall/cascade/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cascade": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint --max-warnings=0 src test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@tierfall/cascade-sdk": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.0",
    "eslint": "9.18.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.11",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
