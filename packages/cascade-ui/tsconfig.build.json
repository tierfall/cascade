{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {}
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tailwind-preset.ts"],
  "exclude": ["dist", "node_modules", "test", "**/*.test.ts", "**/*.test.tsx"]
}
