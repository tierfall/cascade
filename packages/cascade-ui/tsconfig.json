{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["jest", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tailwind-preset.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "jest.config.ts",
    "tsup.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
