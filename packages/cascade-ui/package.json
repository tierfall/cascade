{
  "name": "@tierfall/cascade-ui",
  "version": "0.0.0",
  "description": "Cascade design system: Radix UI primitives + Tailwind classes derived from cascade-tokens. shadcn-style — components are owned in-repo.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/tierfall/cascade.git",
    "directory": "packages/cascade-ui"
  },
  "homepage": "https://github.com/tierfall/cascade",
  "bugs": {
    "url": "https://github.com/tierfall/cascade/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset.d.ts",
        "default": "./dist/tailwind-preset.js"
      },
      "require": {
        "types": "./dist/tailwind-preset.d.cts",
        "default": "./dist/tailwind-preset.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint --max-warnings=0 src test",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.1.1",
    "@tierfall/cascade-tokens": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "2.6.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=3.4.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "10.6.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "3.4.17",
    "ts-jest": "29.4.10",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
